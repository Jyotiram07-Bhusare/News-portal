# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is private: it is in .gitignore and must never be committed.

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=lokmangal_news_portal

# ---- Web server ----
# HOST: 0.0.0.0 = also reachable from phones on the same Wi-Fi, 127.0.0.1 = this PC only
HOST=0.0.0.0
PORT=5000

# true  = this server also serves ../frontend (the site on "/" and the admin panel on "/admin/"):
#         one command for local work.
# false = API only; the frontend is hosted somewhere else (Vercel, Netlify ...).
SERVE_FRONTEND=true

# Websites allowed to call the API from a browser (comma separated). "*" = any site, fine for local work.
# Production example: CORS_ORIGINS=https://www.lokmangal.in,https://lokmangal.in
CORS_ORIGINS=*

# Largest upload accepted by the admin panel (images and weekly PDFs), in MB
MAX_UPLOAD_MB=50

# Optional: where uploads are saved. Default = the frontend's assets folders, so a new
# image / PDF shows up on the site straight away.
# IMAGES_DIR=../frontend/assets/images
# PDF_DIR=../frontend/assets/pdf
