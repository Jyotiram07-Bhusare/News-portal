# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is private: it is in .gitignore and must never be committed.
#
# Two ways to use it:
#   * your PC (development): keep the defaults, only fill in DB_PASSWORD, then run  python manage.py set-admin-password
#   * the EC2 server (production): the "PRODUCTION" values below. The backend REFUSES TO START in production while a setting is unsafe
#     (python manage.py check tells you what to fix).

# development | production
APP_ENV=development

# ---- MySQL (local MySQL, or the Amazon RDS endpoint) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=lokmangal_news_portal
# RDS: encrypt the connection and verify the server. Download the bundle once on the server:
#   sudo curl -o /etc/ssl/certs/rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

# ---- Admin login ----
# The Admin Panel needs a login. Set the password with:  python manage.py set-admin-password   (it writes ADMIN_PASSWORD_HASH here)
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH='...'
# Signs the login tokens - at least 32 random characters, different on every server:  python manage.py gen-secret
# SECRET_KEY=
# A login stays valid this many hours
TOKEN_TTL_HOURS=12

# ---- Web server ----
# HOST: 0.0.0.0 = also reachable from phones on the same Wi-Fi, 127.0.0.1 = this PC only (production: 127.0.0.1, nginx stands in front)
HOST=0.0.0.0
PORT=5000

# true  = this server also serves ../frontend (the site on "/" and the admin panel on "/admin/"): one command for local work.
# false = API only; the frontend is hosted somewhere else (AWS Amplify). Production: false.
SERVE_FRONTEND=true

# Websites allowed to call the API from a browser (comma separated). "*" = any site, fine for local work only.
# Production (required, https only):  CORS_ORIGINS=https://www.lokmangal.in,https://lokmangal.in,https://main.d1234abcd.amplifyapp.com
CORS_ORIGINS=*

# The public website (sitemap, RSS feed and link-preview pages point to it). Production default: https://www.lokmangal.info
# Leave it out on a development PC: those pages then use the address they were opened on.
# SITE_URL=https://www.lokmangal.info

# Number of proxies in front of the app (nginx = 1). Needed so the login limiter sees the visitor's address, not nginx's.
TRUSTED_PROXIES=0

# Largest upload accepted by the admin panel (images and weekly PDFs), in MB
MAX_UPLOAD_MB=50

# Largest video accepted by the admin panel (Videos), in MB
MAX_VIDEO_MB=200

# ---- Files: where uploaded pictures / PDFs / videos are kept ----
# local = the frontend's assets folders (development: a new image shows up on the site straight away)
# s3    = an Amazon S3 bucket read through CloudFront (production). The EC2 instance role gives access - no keys needed.
STORAGE_BACKEND=local
# S3_BUCKET=lokmangal-media-123456789012
# S3_REGION=ap-south-1
# MEDIA_BASE_URL=https://d1234abcd.cloudfront.net
# Optional folder inside the bucket
# S3_PREFIX=
# Uploads are written here first and checked; use a folder on the disk (not a RAM disk) for big videos.
# UPLOAD_TMP_DIR=/var/lib/lokmangal/tmp

# Local storage only (default = the frontend's assets folders)
# IMAGES_DIR=../frontend/assets/images
# PDF_DIR=../frontend/assets/pdf
# VIDEO_DIR=../frontend/assets/videos

# Keep frontend/js/videos-data.js equal to the videos table (a development PC only; leave it off on the server)
# PUBLISH_VIDEOS_FILE=false
