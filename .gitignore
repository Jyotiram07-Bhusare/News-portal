# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Half-finished uploads (the backend writes name.pdf.part first, then renames it)
*.part

# Videos uploaded in the Admin Panel (Videos): large files that live on the machine that runs the backend, not in git
frontend/assets/videos/

# Environment & IDE
.env
.venv/
env/
venv/
.vscode/
.idea/

# The owner's original weekly PDFs (68 files, 134 MB). Their copies live in frontend/assets/pdf/ - the folder itself is not part of the repo
lokmangal saptahik karyakram/

# OS Files
.DS_Store
Thumbs.db

# Uploads waiting to be checked (backend/tmp_uploads) and test leftovers
backend/tmp_uploads/
.pytest_cache/

# Local secrets / keys - never commit
*.pem
# (the public Amazon RDS CA bundle: certificates only, no key)
!backend/certs/rds-global-bundle.pem
*.key
.env.*
!.env.example
